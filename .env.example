# Complete variable template for infra/docker-compose.dev.yml only.
# Existing ignored .env files are not updated automatically; reconcile their
# variable names with this file when the Compose configuration changes.
# Replace local credentials before using any deployed environment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Local-only PostgreSQL for foundation conformance tests; not an application database.
POSTGRES_DB=foundation_conformance
POSTGRES_USER=foundation_test
POSTGRES_PASSWORD=foundation_test

# Local-only PostgreSQL backing the test-only Temporal server.
TEMPORAL_HOST_PORT=7233
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222

# Local-only RabbitMQ for foundation conformance tests; not an application broker.
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# Local-only Capacity Commitment databases and broker. Replace these values
# before using any non-development environment.
CAPACITY_MIGRATION_DB_PASSWORD=capacity_migration_local_only
CAPACITY_RUNTIME_DB_PASSWORD=capacity_runtime_local_only_2026
CAPACITY_RABBITMQ_ADMIN_USER=capacity_admin
CAPACITY_RABBITMQ_ADMIN_PASSWORD=capacity_admin_local_only_2026
CAPACITY_RABBITMQ_APP_USER=capacity_runtime
CAPACITY_RABBITMQ_APP_PASSWORD=capacity_broker_runtime_local_only_2026
CAPACITY_HTTP_HOST_PORT=8086
CAPACITY_RABBITMQ_HOST_PORT=5673

# Local-only Operational Economics database credentials and HTTP port.
ECONOMICS_MIGRATION_DB_PASSWORD=economics_migration_local_only
ECONOMICS_RUNTIME_DB_PASSWORD=economics_runtime_local_only_2026
ECONOMICS_HTTP_HOST_PORT=8087

# Override these loopback ports when the default is already in use.
API_GATEWAY_HOST_PORT=3000
NGINX_HOST_PORT=8080
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3005
POSTGRES_HOST_PORT=5432
