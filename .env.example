# Local development only. Replace secrets before using any deployed environment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Local-only PostgreSQL for foundation conformance tests; not an application database.
POSTGRES_DB=foundation_conformance
POSTGRES_USER=foundation_test
POSTGRES_PASSWORD=foundation_test

# Local-only PostgreSQL backing the test-only Temporal server.
TEMPORAL_HOST_PORT=7233
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222

# Local-only RabbitMQ for foundation conformance tests; not an application broker.
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# Override these loopback ports when the default is already in use.
API_GATEWAY_HOST_PORT=3000
NGINX_HOST_PORT=8080
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3005
POSTGRES_HOST_PORT=5432

# Configure all three when the TMS Identity issuer is deployed.
# IDENTITY_ISSUER=https://identity.example.invalid
# IDENTITY_AUDIENCE=tms-api
# IDENTITY_JWKS_URI=https://identity.example.invalid/.well-known/jwks.json
