{
  "name": "tms-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:all": "pnpm -w -r exec tsc -b",
    "start:all": "pnpm -w -r --parallel start",
    "dev:all": "pnpm -w -r --parallel --filter './services/*' dev",
    "lint": "eslint './**/*.{ts,js,tsx,jsx}' --max-warnings 0",
    "format": "prettier --write './**/*.{ts,js,json,md,tsx,jsx}'",
    "test": "pnpm run test:unit",
    "test:all": "vitest run",
    "test:unit": "vitest run --exclude '**/tests/integration/**' --exclude '**/tests/e2e/**'",
    "prepare": "husky",
    "docker:up": "docker compose -f infra/docker-compose.dev.yml up -d --build",
    "docker:down": "docker compose -f infra/docker-compose.dev.yml down --remove-orphans",
    "docker:postgres:up": "docker compose -f infra/docker-compose.dev.yml up -d postgres",
    "docker:postgres:down": "docker compose -f infra/docker-compose.dev.yml stop postgres",
    "docker:rabbitmq:up": "docker compose -f infra/docker-compose.dev.yml up -d rabbitmq",
    "docker:rabbitmq:down": "docker compose -f infra/docker-compose.dev.yml stop rabbitmq",
    "docker:temporal:up": "docker compose -f infra/docker-compose.dev.yml up -d temporal",
    "docker:temporal:down": "docker compose -f infra/docker-compose.dev.yml stop temporal temporal-postgres",
    "docker:nats:up": "docker compose -f infra/docker-compose.dev.yml up -d nats",
    "docker:nats:down": "docker compose -f infra/docker-compose.dev.yml stop nats",
    "docker:logs": "docker compose -f infra/docker-compose.dev.yml logs -f --tail=200",
    "docker:status": "docker compose -f infra/docker-compose.dev.yml ps --all",
    "docker:health": "NGINX_BINDING=\"$(docker compose -f infra/docker-compose.dev.yml port nginx 80)\" && API_GATEWAY_BINDING=\"$(docker compose -f infra/docker-compose.dev.yml port api-gateway 3000)\" && NGINX_PORT=\"${NGINX_BINDING##*:}\" && API_GATEWAY_PORT=\"${API_GATEWAY_BINDING##*:}\" && test -n \"$NGINX_PORT\" && test -n \"$API_GATEWAY_PORT\" && curl -fsS \"http://127.0.0.1:$NGINX_PORT/health\" && echo && curl -fsS \"http://127.0.0.1:$API_GATEWAY_PORT/ready\" && echo",
    "test:integration:postgres": "POSTGRES_INTEGRATION=1 vitest run infra/tests/integration/postgres-persistence.test.ts",
    "test:integration:messaging": "RABBITMQ_INTEGRATION=1 vitest run infra/tests/integration/rabbitmq-messaging.test.ts",
    "test:integration:temporal": "TEMPORAL_INTEGRATION=1 vitest run infra/tests/integration/temporal-workflow-recovery.test.ts",
    "test:integration:nats": "NATS_INTEGRATION=1 vitest run infra/tests/integration/nats-fanout-observability.test.ts",
    "test:integration:foundation-recovery": "FOUNDATION_RECOVERY_INTEGRATION=1 vitest run infra/tests/integration/foundation-recovery.test.ts",
    "docker:gateway-contract": "node scripts/gateway-contract-check.mjs",
    "docker:rebuild": "docker compose -f infra/docker-compose.dev.yml build --no-cache"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "@temporalio/client": "1.15.0",
    "@temporalio/common": "1.15.0",
    "@temporalio/worker": "1.15.0",
    "@temporalio/workflow": "1.15.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "amqplib": "^2.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nats": "2.29.3",
    "prettier": "^3.9.6",
    "turbo": "^2.11.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
