{
  "name": "service-api-gateway",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "prebuild": "pnpm run clean",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test:e2e": "cd ../.. && E2E=1 pnpm exec vitest run services/api-gateway/tests/e2e/health.test.ts"
  },
  "dependencies": {
    "@app/common": "workspace:*",
    "@app/identity-token": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "jose": "^6.1.0",
    "tsx": "^4.23.13"
  }
}
